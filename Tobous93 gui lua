-- Helper Functions
local function getHDAdmin()
	local success, rc = pcall(function()
		return ReplicatedStorage:WaitForChild("HDAdminHDClient", 2).Signals.RequestCommandSilent
	end)
	return rc
end

local function getF3XRemote()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local tool = (backpack and backpack:FindFirstChild("Building Tools")) or (char and char:FindFirstChild("Building Tools"))
	if tool then
		local endpoint = tool:FindFirstChild("SyncAPI") and tool.SyncAPI:FindFirstChild("ServerEndpoint")
		return endpoint
	end
	return nil
end

-- Function to lock everything and setup auto-lock + HD Admin command
local function applyRealmLock()
	local function lockAll()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") then
				local model = obj:FindFirstAncestorOfClass("Model")
				if not model or not Players:GetPlayerFromCharacter(model) then
					obj.Locked = true
				end
			end
		end
	end
	lockAll()
	Workspace.DescendantAdded:Connect(function(obj)
		if obj:IsA("BasePart") then
			local model = obj:FindFirstAncestorOfClass("Model")
			if not model or not Players:GetPlayerFromCharacter(model) then
				obj.Locked = true
			end
		end
	end)
	task.spawn(function()
		local hd = _G.HDAdminMain
		if hd and hd.CommandModule then
			hd.CommandModule:AddCommand({
				Name = "lockall", Aliases = {"lockmap"}, Prefixes = {";", ":"}, Rank = 2, Arguments = {},
				Description = "Lock map",
				Function = function(speaker, args) lockAll() return "Locked!" end
			})
		end
	end)
end

